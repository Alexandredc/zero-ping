# Optional: by default the token of the local `gh` CLI is used.
# GITHUB_TOKEN=

# Jev (TypeSafe) scores priorities. Without a key, only deterministic rules apply.
TYPESAFE_AI_API_KEY=

# Decision model: `typesafe:<model>` (default typesafe:jev-latest) or `anthropic:<model>`.
# AI_DECISION_MODEL=typesafe:jev-latest
# ANTHROPIC_API_KEY=

# Slack discussions are found by a coding agent using your own Slack access.
# AGENT_CLI=claude            # or codex
# AGENT_MODEL=haiku           # default: haiku for claude, your config for codex
# AGENT_COMMAND=              # executable path when not on the PATH
# SLACK_AGENT_TOOLS=          # Claude Code tool names of another Slack MCP server
# SLACK_AGENT_SEND_TOOL=      # Claude Code tool that posts Slack replies
# SLACK_SEARCH=off            # disables the Slack search

# Where PGlite stores its data (default .data/pglite).
# DATA_DIR=
